{
  "name": "super-bots",
  "version": "0.1.0",
  "description": "Simultaneous-turn 2D artillery brawler for 2-8 bots (Brawlbots genre), single-player vs AI",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "offline": "python3 -m http.server 8000",
    "test": "node test/headless.mjs 40 && node test/features.mjs",
    "test:online": "node test/online.mjs",
    "test:online-browser": "node test/online-browser.mjs",
    "balance": "node test/balance.mjs 3"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  },
  "license": "MIT"
}
