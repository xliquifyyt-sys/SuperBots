# Copy to .env and fill in the provider ids when you are ready.
# Never commit .env. Guest login works with none of these set.

PORT=8080
# Directory for the SQLite file. Defaults to server/data/
# DATA_DIR=server/data

# Web Google sign-in (and the same id the Android / iOS builds will use).
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID.
# Create a Web client, plus Android and iOS clients, all under one project.
# GOOGLE_CLIENT_ID=

# Sign in with Apple. Apple Developer -> Identifiers -> Services ID.
# The native Capacitor app posts Apple's identity token to /api/auth/apple.
# APPLE_CLIENT_ID=
